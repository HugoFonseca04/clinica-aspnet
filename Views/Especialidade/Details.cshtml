@model Especialidade
@{ ViewData["Title"] = "Detalhes da Especialidade"; }<h1>Detalhes da Especialidade</h1><dl class="row"><dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd><dt class="col-sm-3">Descrição</dt><dd class="col-sm-9">@Model.Descricao</dd><dt class="col-sm-3">Área</dt><dd class="col-sm-9">@Model.AreaAtuacao</dd><dt class="col-sm-3">Duração</dt><dd class="col-sm-9">@Model.DuracaoConsulta minutos</dd><dt class="col-sm-3">Ativa</dt><dd class="col-sm-9">@(Model.Ativa?"Sim":"Não")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Voltar</a>
