@model Paciente
@{ ViewData["Title"] = "Detalhes do Paciente"; }<h1>Detalhes do Paciente</h1><dl class="row">@foreach(var p in new[]{("Nome",Model.Nome),("CPF",Model.Cpf),("Telefone",Model.Telefone),("E-mail",Model.Email),("Nascimento",Model.DataNascimento.ToString("dd/MM/yyyy")),("Endereço",Model.Endereco),("Ativo",Model.Ativo ? "Sim":"Não")}) { <dt class="col-sm-3">@p.Item1</dt><dd class="col-sm-9">@p.Item2</dd> }</dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> <a asp-action="Index" class="btn btn-secondary">Voltar</a>
