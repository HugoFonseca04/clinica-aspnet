@model IEnumerable<Profissional>
@{ ViewData["Title"] = "Profissionais"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1>Profissionais</h1><a asp-action="Create" class="btn btn-primary">Novo profissional</a></div>
@if (TempData["Mensagem"] != null) { <div class="alert alert-success">@TempData["Mensagem"]</div> }
<table class="table table-striped"><thead><tr><th>Nome</th><th>Registro</th><th>Telefone</th><th>E-mail</th><th>Especialidade</th><th>Ativo</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Nome</td><td>@item.RegistroProfissional</td><td>@item.Telefone</td><td>@item.Email</td><td>@item.Especialidade?.Nome</td><td>@(item.Ativo?"Sim":"Não")</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a></td></tr>}</tbody></table>
